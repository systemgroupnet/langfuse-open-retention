# Add these to the .env your Langfuse stack already uses.
#
# Only RETENTION_ADMIN_PASSWORD is required. Everything else resolves as
# ${RETENTION_X:-${X:-stock-default}}, so the retention service reuses whatever
# your stack already defines and you override only where it needs to differ.

# ═══ Required ════════════════════════════════════════════════════════════════
RETENTION_ADMIN_PASSWORD=change-me
# Set this or every container restart signs everyone out. Any long random string:
#   openssl rand -hex 32
RETENTION_COOKIE_SECRET=

# ═══ Langfuse API access ═════════════════════════════════════════════════════
# Organization-scoped key: lets the tool see every project and mint its own
# project-scoped keys for trace deletion. Organization Settings -> API Keys.
LANGFUSE_ORG_PUBLIC_KEY=
LANGFUSE_ORG_SECRET_KEY=

# Alternative to the org key: explicit project-scoped keys as JSON.
# LANGFUSE_PROJECT_KEYS={"cm0abc123":{"publicKey":"pk-lf-...","secretKey":"sk-lf-..."}}

# Stop the tool creating API keys for itself.
# LANGFUSE_AUTO_PROVISION_KEYS=false

# ═══ Overrides for a customised stack ════════════════════════════════════════
# Only needed where your service names or credentials differ from the stock
# Langfuse compose file. Each is optional.

# If langfuse-web is reachable under a different name or port internally.
# RETENTION_LANGFUSE_BASE_URL=http://langfuse-web:3000

# If your Postgres service is not called `postgres`. Skip this if your .env
# already sets DATABASE_URL — the retention service inherits it.
# RETENTION_DATABASE_URL=postgresql://postgres:postgres@langfuse-postgres:5432/postgres

# If your ClickHouse service is not called `clickhouse`. Same inheritance rule.
# RETENTION_CLICKHOUSE_URL=http://clickhouse:8123
# Only for a clustered ClickHouse; leave unset for single-node.
# RETENTION_CLICKHOUSE_CLUSTER_NAME=

# IMPORTANT if your MinIO service is not called `minio`.
#
# One internally reachable endpoint is used for events, media and batch exports.
# Do not reuse LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT or _BATCH_EXPORT_ENDPOINT here:
# Langfuse frequently points those at a browser-facing address such as
# http://localhost:9090 because it signs upload URLs with them, and that does not
# resolve from inside a container. Use the address the langfuse-worker uses.
# RETENTION_S3_ENDPOINT=http://langfuse-minio:9000
# RETENTION_S3_ACCESS_KEY_ID=minio
# RETENTION_S3_SECRET_ACCESS_KEY=miniosecret

# ═══ Storage reporting ═══════════════════════════════════════════════════════
# Named Docker volumes are measured through the Docker socket automatically.
#
# If your stack bind-mounts its data instead (volumes like /mnt/data/langfuse/...),
# `docker system df` cannot see it. Mount the parent directory read-only and list
# the directories to measure. This also reports free space on that filesystem.
#
#   RETENTION_HOSTFS_PATH=/mnt/data/langfuse
#   RETENTION_DISK_PATHS=ClickHouse=/hostfs/clickhouse/_data,MinIO=/hostfs/minio/_data
#
# Paths are as seen *inside* the container, i.e. under /hostfs.
# A Postgres data directory is mode 0700 and unreadable to any other user; leave
# it out, since pg_database_size() already reports it exactly.
# RETENTION_HOSTFS_PATH=
# RETENTION_DISK_PATHS=

# Withhold the Docker socket entirely (volume sizes then show as unavailable).
# RETENTION_DOCKER_SOCKET=/dev/null
# RETENTION_DOCKER_STATS_ENABLED=false

# A directory walk is expensive, so results are cached this long.
# RETENTION_DOCKER_STATS_CACHE_SECONDS=900

# ═══ Service placement ═══════════════════════════════════════════════════════
# Where the build context lives, relative to the compose file.
# RETENTION_BUILD_CONTEXT=./langfuse-open-retention
# RETENTION_IMAGE=langfuse-open-retention:latest
# RETENTION_CONTAINER_NAME=langfuse-retention
# RETENTION_MEM_LIMIT=512m

# Host port. Loopback-only by default because this dashboard deletes data.
# RETENTION_PORT=3050
# RETENTION_BIND_IP=127.0.0.1

# Persist policy and run history somewhere other than a named volume.
# RETENTION_DATA_VOLUME=/mnt/data/langfuse/retention/_data

# Only used by the commented-out reverse-proxy labels in the compose file.
# RETENTION_HOSTNAME=retention.example.com
# RETENTION_BASIC_AUTH=user:$$apr1$$...

# Trusted-network escape hatch: no password at all.
# RETENTION_AUTH_DISABLED=false
# RETENTION_LOG_LEVEL=info
